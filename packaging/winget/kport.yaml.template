# yaml-language-server: $schema=https://aka.ms/winget-manifest.singleton.1.6.0.schema.json
PackageIdentifier: AlienHub.kport
PackageVersion: {version}
PackageLocale: en-US
PackageName: kport
Publisher: Alien Hub
License: Apache-2.0
ShortDescription: Cross-platform port inspector and killer
